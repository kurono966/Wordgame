# Deck size limits, so "add card" / "remove card" can never break the draw loop.
const MIN_DECK_SIZE: int = 5
const MAX_DECK_SIZE: int = 40


# ─── Rewards ─────────────────────────────────────────────────────────────────
## Builds 3 distinct reward options for the player to choose from.
## Always offers at least one deck change (add or remove) plus stat options,
## so the deck is something the player actually shapes between fights.
func roll_rewards() -> Array:
	reward_options = []
	pending_reward_choice = true
	_build_deck_rewards()
	_build_stat_rewards()
	# Shuffle so the order differs each time, but keep it stable for the UI.
	reward_options.shuffle()
	return reward_options


## The reward options that are already on offer, WITHOUT rolling new ones.
## Returning from the BURN A CARD picker uses this, so backing out of the deck
## picker leaves the player looking at exactly the same three choices instead of
## a fresh roll.
func get_pending_reward_options() -> Array:
	if not pending_reward_choice:
		return []
	return reward_options


## Adds one "gain this card" and one "burn a card" option when the deck size
## allows. The card you GAIN is rolled up front and shown face-up.
func _build_deck_rewards() -> void:
	if deck.size() < MAX_DECK_SIZE:
		var card: Dictionary = _pick_reward_card()
		var title: String = "ADD A CARD"
		var detail: String = "Add this card to your deck."
		if has_special_ability(card):
			title = "★ SPECIAL CARD"
			detail = "★ %s (%d OP)\n%s" % [
				get_special_name(card),
				get_special_cost(card),
				get_special_desc(card)
			]
		reward_options.append({"type": "add_card", "title": title,
			"detail": detail,
			"card": card})
	if deck.size() > MIN_DECK_SIZE:
		# No card is chosen here: the player picks one from the burn list.
		reward_options.append({"type": "remove_card", "title": "BURN A CARD",
			"detail": "Choose a card from your deck to remove."})


## Lists every card the player may burn, as stable pick entries.
## This is the WHOLE deck: the draw pile, the hand, and the graveyard. The
## graveyard is included because burning a card there really does remove it —
## the graveyard is only recycled into the deck when the deck runs dry, so a card
## taken out of it never comes back.
## Each entry carries the source and index so the UI can hand back a precise
## reference instead of guessing from letter/damage.
func get_burnable_cards() -> Array:
	var out: Array = []
	for i in range(deck.size()):
		out.append({"id": "deck:%d" % i, "source": "deck", "index": i,
			"card": deck[i].duplicate()})
	for i in range(hand.size()):
		if hand[i] != null:
			out.append({"id": "hand:%d" % i, "source": "hand", "index": i,
				"card": hand[i].duplicate()})
	for i in range(graveyard.size()):
		if graveyard[i] != null:
			out.append({"id": "grave:%d" % i, "source": "grave", "index": i,
				"card": graveyard[i].duplicate()})
	return out


## Finishes a "burn a card" reward by removing the card the player picked.
## `card_id` is one of the ids from get_burnable_cards(). Leaves the reward
## pending if the id is unknown, so a mis-click cannot consume the reward.
func confirm_burn_card(card_id: String) -> Dictionary:
	if not pending_reward_choice or pending_burn_index < 0:
		return {"ok": false, "reason": "no burn in progress"}
	var parts: PackedStringArray = card_id.split(":")
	if parts.size() != 2:
		return {"ok": false, "reason": "bad card id"}
	var source: String = parts[0]
	var idx: int = int(parts[1])

	var burned: Dictionary = {}
	if source == "deck":
		if idx < 0 or idx >= deck.size():
			return {"ok": false, "reason": "card no longer in deck"}
		burned = deck[idx]
		deck.remove_at(idx)
	elif source == "hand":
		if idx < 0 or idx >= hand.size() or hand[idx] == null:
			return {"ok": false, "reason": "card no longer in hand"}
		burned = hand[idx]
		hand[idx] = null
		# Top the slot back up so the hand stays full. Skipped when a whole fresh
		# hand is already owed (the reward screen), because the redraw is about to
		# replace the whole hand anyway and drawing here would be wasted churn.
		if not hand_redraw_pending:
			_refill_hand()
	elif source == "grave":
		if idx < 0 or idx >= graveyard.size() or graveyard[idx] == null:
			return {"ok": false, "reason": "card no longer in the graveyard"}
		burned = graveyard[idx]
		graveyard.remove_at(idx)
	else:
		return {"ok": false, "reason": "unknown source"}

	# Reset shield when claiming a reward after defeating an enemy
	shield = 0

	pending_burn_index = -1
	pending_reward_choice = false
	reward_options = []
	rewards_taken += 1
	return {
		"ok": true,
		"type": "remove_card",
		"card": burned,
		"message": "Burned %s (%d dmg, %s) from your deck (now %d cards)." % [
			burned.get("letter", "?"), int(burned.get("damage", 0)),
			str(burned.get("color", "red")).to_upper(), deck.size()]
	}


## Abandons a burn pick so the three reward options come back.
func cancel_burn_card() -> void:
	pending_burn_index = -1


func is_burning() -> bool:
	return pending_burn_index >= 0


## Picks a random card from SPECIAL_CARD_DEFS. Rewards go straight into the
## player's deck, which is made of PLAYER cards — the skill card only ever exists
## on the shared reels, so any letter is safe to offer here.
func _pick_special_reward_card() -> Dictionary:
	if SPECIAL_CARD_DEFS.is_empty():
		return _pick_reward_card()
	return SPECIAL_CARD_DEFS[randi() % SPECIAL_CARD_DEFS.size()].duplicate()


## Picks a random card for the reward. 70% chance to offer a SPECIAL card,
## ensuring specials appear reliably through victory rewards.
func _pick_reward_card() -> Dictionary:
	if not SPECIAL_CARD_DEFS.is_empty() and randf() < 0.7:
		return _pick_special_reward_card()
	if CARD_DEFS.is_empty():
		return {"letter": "E", "damage": 1, "color": "red"}
	return CARD_DEFS[randi() % CARD_DEFS.size()].duplicate()


## Stat rewards, offered with weights that keep all three useful.
func _build_stat_rewards() -> void:
	var pool: Array = [
		{"type": "heal", "title": "VITALITY", "detail": "Restore HP."},
		{"type": "shield", "title": "BARRIER", "detail": "Gain shield."},
		{"type": "op", "title": "INSIGHT", "detail": "Gain operation points."},
		{"type": "max_hp", "title": "IRON WILL", "detail": "Raise max HP."},
		{"type": "draw", "title": "CARD DRAW", "detail": "Draw a card into hand."}
	]
	pool.shuffle()
	# Fill up to three options, but never duplicate a deck option already added.
	for reward: Dictionary in pool:
		if reward_options.size() >= 3:
			break
		reward_options.append(reward)


## Applies the reward the player chose. `index` is the position in reward_options.
##
## "remove_card" is a two-step reward: the first call opens the pick list (it
## returns {"ok": true, "needs_card": true} and keeps the choice pending), then
## the player picks a card and confirm_burn_card() finishes it.
func choose_reward(index: int) -> Dictionary:
	if not pending_reward_choice:
		return {"ok": false, "reason": "no pending choice"}
	if index < 0 or index >= reward_options.size():
		return {"ok": false, "reason": "invalid index"}
	var reward: Dictionary = reward_options[index]
	var result: Dictionary = {"ok": true, "type": reward.get("type", ""),
		"title": reward.get("title", ""), "message": ""}
	# Carried shield from the fight that just ended is dropped, unless the
	# reward being claimed IS the shield reward.
	var keep_shield: bool = str(reward.get("type", "")) == "shield"

	match str(reward.get("type", "")):
		"add_card":
			# Use the card that was rolled when the option was created, so the
			# player gets exactly the card they were shown.
			var card: Dictionary = reward.get("card", _pick_reward_card())
			deck.append(card.duplicate())
			result["card"] = card
			var special_note: String = (" ★ " + get_special_name(card)) if has_special_ability(card) else ""
			result["message"] = "Added %s (%d dmg, %s%s) to your deck (now %d cards)." % [
				card.get("letter", "?"), int(card.get("damage", 0)),
				str(card.get("color", "red")).to_upper(), special_note, deck.size()]
		"remove_card":
			# Wait for the player to pick which card to burn.
			pending_burn_index = index
			result["needs_card"] = true
			result["message"] = "Choose a card to burn from your deck."
			return result
		"heal":
			var amount: int = maxi(10, int(round(float(player_hp) * 0.25)))
			amount = mini(amount, player_max_hp - player_hp)
			player_hp += amount
			result["message"] = "Restored %d HP (now %d)." % [amount, player_hp]
		"shield":
			var gain: int = 8
			shield = gain
			result["message"] = "Gained %d shield (now %d)." % [gain, shield]
		"op":
			operation_points += 5
			result["message"] = "Gained 5 OP (now %d)." % operation_points
		"max_hp":
			# Raise the CEILING, and grant the new headroom as current HP too so
			# the reward is felt immediately (previously this only added 5 to
			# current HP, pushing the player ABOVE the old ceiling and making
			# every later heal subtract HP).
			player_max_hp += MAX_HP_REWARD_GAIN
			player_hp = mini(player_hp + MAX_HP_REWARD_GAIN, player_max_hp)
			result["message"] = "Max HP is now %d (+%d)." % [player_max_hp, MAX_HP_REWARD_GAIN]
		"draw":
			var drawn: Dictionary = _draw_card()
			hand.append(drawn)
			result["message"] = "Drew %s (%d dmg) into your hand." % [
				drawn.get("letter", "?"), int(drawn.get("damage", 0))]

	# Reset shield when claiming a reward after defeating an enemy. A shield
	# reward keeps its own value, otherwise it would cancel itself out.
	if not keep_shield:
		shield = 0

	pending_reward_choice = false
	reward_options = []
	rewards_taken += 1
	return result


func has_pending_reward() -> bool:
	return pending_reward_choice


func get_reward_options() -> Array:
	return reward_options


func get_deck_size() -> int:
	return deck.size()


# ─── Initialisation ──────────────────────────────────────────────────────────
func _ready() -> void:
	reset_game()
	_load_dictionary()

func reset_game() -> void:
	player_hp = PLAYER_MAX_HP
	player_max_hp = PLAYER_MAX_HP
	shield = 0
	enemy_hp = ENEMY_BASE_HP
	operation_points = 0
	word_multiplier = 1
	night_penalty_immune = false
	stage_cleared_immune = false
	turn = 0

	enemy_max_hp = ENEMY_BASE_HP
	enemies_defeated = 0
	stage = 1
	total_damage = 0
	turn = 0
	is_night = false
	game_over = false
	game_outcome = ""
	graveyard.clear()
	deck.clear()
	slots.clear()
	hand.clear()
	current_slot_indices = [0, 0, 0]
	reward_options = []
	rewards_taken = 0
	pending_reward_choice = false
	pending_burn_index = -1
	slot_in_use = [false, false, false]
	hand_redraw_pending = false

	# Every enemy-granted effect from the previous run is wiped before the first
	# enemy is rolled, so a fresh game never inherits a shield or a shrunken hand.
	_clear_enemy_skills()

	# Roll this stage's enemy: its name's letters fill the shared reels, and one
	# of them becomes the single skill card dealt to them.
	# (shared cards are separate from the player's deck)
	enemy_name = _roll_enemy_name()
	_roll_enemy_skills()

	# The deck is the fixed 20-card player set. These are PLAYER cards, never the
	# skill card: the skill lives on exactly one shared reel card and only fires
	# from a bottom row at night, which no deck card can ever do. So the deck may
	# safely contain the skill letter without weakening the rule.
	for card_def in STARTING_DECK:
		deck.append(card_def.duplicate())

	# The SET is fixed, but the ORDER is not: the deck is shuffled before the
	# opening hand is dealt. Drawing pops from the back of the deck, so without
	# this the last seven cards of STARTING_DECK were the same opening hand every
	# single game. Shuffling here, and again in _reshuffle_graveyard() whenever the
	# spent pile is recycled, keeps every draw random.
	deck.shuffle()

	_build_shared_slots()

	# Deal the opening hand, honouring any HAND DOWN already in force
	for _h in range(hand_limit):
		hand.append(_draw_card())

## Loads the word list and the Japanese glosses from res://word_dictionary.json
## (see build_word_json.py, which generates it from dictionary.txt). The JSON
## carries the COMPLETE word list for validation plus a (much smaller) table of
## translations. If it is missing or malformed, dictionary.txt is used as before
## so the game still runs.
func _load_dictionary() -> void:
	if _load_dictionary_json():
		return
	_load_dictionary_txt()


func _load_dictionary_json() -> bool:
	var file := FileAccess.open(WORD_DICTIONARY_PATH, FileAccess.READ)
	if file == null:
		push_warning("Word dictionary JSON not found at %s; falling back to dictionary.txt" % WORD_DICTIONARY_PATH)
		return false
	var text := file.get_as_text()
	file.close()

	var parsed: Variant = JSON.parse_string(text)
	if typeof(parsed) != TYPE_DICTIONARY:
		push_error("Word dictionary JSON is not an object; falling back to dictionary.txt")
		return false
	var data: Dictionary = parsed

	var words: Array = data.get("words", [])
	if words.is_empty():
		push_error("Word dictionary JSON has no 'words'; falling back to dictionary.txt")
		return false

	word_translations = {}
	var raw_translations: Dictionary = data.get("translations", {})
	for key: Variant in raw_translations:
		var gloss := str(raw_translations[key]).strip_edges()
		if gloss != "":
			word_translations[str(key).to_lower()] = gloss

	# `words` is sorted, so membership can use a binary search on a PackedStringArray
	# instead of a 400k-entry Dictionary: same result, far less memory and a much
	# faster load. Duplicate lookups are the common case in word validation.
	_sorted_words = PackedStringArray()
	for w: Variant in words:
		var word := str(w).to_lower()
		dictionary[word] = true
		if _is_valid_enemy_name(word):
			word_list.append(word.to_upper())
		_sorted_words.append(word)

	# A word that carries a translation is stored ONLY under "translations" (the
	# JSON keeps the two sections disjoint), so it must still count as a valid
	# word here — otherwise translated words would be rejected as not-a-word.
	for key: String in word_translations:
		if dictionary.has(key):
			continue
		dictionary[key] = true
		if _is_valid_enemy_name(key):
			word_list.append(key.to_upper())
		_sorted_words.append(key)
	_sorted_words.sort()

	print("Dictionary JSON loaded with ", dictionary.size(), " words (",
		word_list.size(), " enemy-name candidates, ", word_translations.size(), " translations)")
	return true


## Legacy loader: the plain newline-separated word list.
func _load_dictionary_txt() -> void:
	var file = FileAccess.open("res://dictionary.txt", FileAccess.READ)
	if file == null:
		push_error("Dictionary not found at res://dictionary.txt")
		print("ERROR: Dictionary file not found. Using fallback dictionary.")
		# Fallback dictionary for web export if file not found
		_add_fallback_words()
		return
	while not file.eof_reached():
		var line = file.get_line().strip_edges()
		if line != "":
			dictionary[line.to_lower()] = true
			if _is_valid_enemy_name(line):
				word_list.append(line.to_upper())
	file.close()
	print("Dictionary loaded with ", dictionary.size(), " words (", word_list.size(), " enemy-name candidates)")

# ─── Enemy names ─────────────────────────────────────────────────────────────
# True when a dictionary word can be used as an enemy name: pure A-Z letters
# and short enough for the whole name to fit into the9 shared cards.
func _is_valid_enemy_name(word: String) -> bool:
	var w: String = word.strip_edges()
	if w.length() < NAME_MIN_LEN or w.length() > NAME_MAX_LEN:
		return false
	for i in range(w.length()):
		if ALPHA.find(w[i].to_upper()) < 0:
			return false
	return true

# Pick a random enemy name from the dictionary (falls back to a small built-in
# list when the dictionary is unavailable).
func _roll_enemy_name() -> String:
	if word_list.is_empty():
		return String(FALLBACK_ENEMY_NAMES.pick_random())
	return String(word_list.pick_random())

# ─── Enemy skills ─────────────────────────────────────────────────────────────
# An enemy is built out of the letters of its own name, and ONE of those
# letters carries a skill. The reel is dealt from the same letters, so the
# skill card is always visible somewhere on the board — exactly one card, and
# its POSITION (bottom row, at night) is what triggers it.
#
# Nothing here outlives the enemy: _advance_stage() calls _clear_enemy_skills()
# as soon as a stage is cleared, restoring the hand limit, dropping the enemy
# shield and the night tax, and wiping the skill list for the incoming enemy.

## Every letter that actually has at least one card in CARD_DEFS.
## Q and X are absent from the pool (they exist only as reward-only specials), so
## they can never be dealt to the shared reels. Cached because CARD_DEFS is a
## large constant and this is consulted on every enemy roll.
func _dealable_letters() -> Dictionary:
	if _dealable_letter_cache.size() > 0:
		return _dealable_letter_cache
	var out: Dictionary = {}
	for def in CARD_DEFS:
		var letter: String = str(def.get("letter", "")).to_upper()
		if ALPHA.find(letter) >= 0:
			out[letter] = true
	_dealable_letter_cache = out
	return out


## The strength of a skill at the given stage (base + growth, capped).
func _enemy_skill_value(def: Dictionary, at_stage: int) -> int:
	var value: int = int(def.get("base", 0)) + int(def.get("step", 0)) * maxi(at_stage - 1, 0)
	return mini(value, int(def.get("max", value)))


## Binds ENEMY_SKILL_COUNT letters of the current name to ENEMY_SKILL_COUNT
## distinct skills. The letters are shuffled so two enemies built from the same
## word do not always play the same way.
## Only letters that actually exist as cards are considered (see
## _dealable_letters): Q and X have no entry in CARD_DEFS, so a skill bound to
## one could never be dealt to the reels — and the deck bans them too, leaving
## the skill with no card anywhere and therefore impossible to trigger.
func _roll_enemy_skills() -> void:
	enemy_skills.clear()
	if ENEMY_SKILL_DEFS.is_empty():
		return

	var dealable: Dictionary = _dealable_letters()
	var letters: Array = []
	var seen: Dictionary = {}
	for ch in enemy_name.to_upper():
		if ALPHA.find(ch) < 0 or seen.has(ch) or not dealable.has(ch):
			continue
		seen[ch] = true
		letters.append(ch)
	if letters.is_empty():
		return

	# A very short name can hold fewer distinct letters than we need skills, so
	# cycle back through what we have rather than dropping a skill slot.
	letters.shuffle()
	var cursor: int = 0
	while letters.size() < ENEMY_SKILL_COUNT:
		letters.append(String(letters[cursor % seen.size()]))
		cursor += 1

	var defs: Array = ENEMY_SKILL_DEFS.duplicate()
	defs.shuffle()
	for i in range(ENEMY_SKILL_COUNT):
		var def: Dictionary = defs[i % defs.size()]
		var letter: String = String(letters[i])
		enemy_skills.append({
			"letter": letter,
			"id": str(def.get("id", "")),
			"name": str(def.get("name", "")),
			"icon": str(def.get("icon", "?")),
			"desc": str(def.get("desc", "")),
			"value": _enemy_skill_value(def, stage),
			"cooldown": 0,
		})


## The skill card's location on the shared reels, or an empty dictionary when
## the skill card is not showing right now.
## A reel shows three rows: 0 = top (coming up), 1 = centre (ACTIVE),
## 2 = bottom (NEXT). Only the bottom row counts as "in the firing line".
## `rotating_slots` mirrors the end-of-turn rotation: a used reel advances first,
## so its bottom row is 2 steps on, an unused one only 1 (same maths as
## get_next_slot_penalty_with_multiplier).
## Returns [{skill, slot, row, letter, next_row}, ...].
func get_skill_card_in_firing_line(rotating_slots: Array = []) -> Array:
	var out: Array = []
	if enemy_skills.is_empty():
		return out
	var skill_letter: String = str(enemy_skills[0].get("letter", ""))
	for s in range(NUM_SLOTS):
		if s >= slots.size():
			continue
		var s_cards: Array = slots[s]
		if s_cards.is_empty():
			continue
		var cur_i: int = current_slot_indices[s] % s_cards.size()
		var steps: int = 2 if rotating_slots.has(s) else 1
		var row: int = (cur_i + steps) % s_cards.size()
		if str(s_cards[row].get("letter", "")) == skill_letter:
			out.append({
				"skill": enemy_skills[0],
				"slot": s,
				"row": row,
				"letter": skill_letter,
			})
	return out


## Whether the skill card will be sitting in the bottom row of any reel when
## NIGHT resolves. Drives the submit forecast and the reels' warning highlight.
func will_skill_fire_at_night(rotating_slots: Array = []) -> bool:
	return not get_skill_card_in_firing_line(rotating_slots).is_empty()


## Every skill the enemy would wake if NIGHT resolved right now with these
## reels turning. Returns the same shape as _apply_enemy_skills().
func _preview_skill_card_night(rotating_slots: Array, shield: int, hp: int, enemy_hp_pool: int) -> Dictionary:
	var out := {
		"log": [], "player_damage": 0, "player_absorbed": 0,
		"enemy_shield": 0, "enemy_heal": 0, "night_tax": 0,
		"shield_after": shield, "hp_after": hp,
	}
	for hit in get_skill_card_in_firing_line(rotating_slots):
		var skill: Dictionary = hit["skill"]
		var id: String = str(skill.get("id", ""))
		var value: int = int(skill.get("value", 0))
		var label: String = "%s [%s]" % [str(skill.get("name", "SKILL")), str(hit.get("letter", ""))]
		match id:
			"aegis":
				out["enemy_shield"] = int(out["enemy_shield"]) + value
				out["shield_after"] = int(out["shield_after"]) + value
				out["log"].append("%s — enemy raises %d shield (now %d)." % [
					label, value, int(out["shield_after"])])
			"hand_down":
				out["log"].append("%s — your hand now holds at most %d cards." % [
					label, maxi(ENEMY_MIN_HAND_LIMIT, hand_limit - value)])
			"drain":
				var drained: int = mini(operation_points, value)
				out["log"].append("%s — %d operation points drained (%d left)." % [
					label, drained, operation_points - drained])
			"nightmare":
				out["night_tax"] = int(out["night_tax"]) + value
				out["log"].append("%s — NIGHT damage base +%d (now %d)." % [
					label, value, enemy_night_tax + value])
			"regrow":
				var healed: int = mini(value, enemy_hp_pool)
				out["enemy_heal"] = int(out["enemy_heal"]) + healed
				out["log"].append("%s — enemy repairs %d HP (now %d / %d)." % [
					label, healed, enemy_hp_pool + healed, enemy_max_hp])
	return out


## Drops every effect the current enemy granted. Called when a stage is cleared
## and by reset_game(). HP the player already lost is deliberately NOT restored:
## that damage is recoverable through healing, and rewriting it would throw away
## the player's real progress.
func _clear_enemy_skills() -> void:
	enemy_shield = 0
	enemy_night_tax = 0
	hand_limit = HAND_SIZE
	enemy_skills.clear()


## The skill bound to `letter`, or an empty dictionary when the enemy has no
## skill on it. Wildcards ("?") never match — a wildcard is not the enemy's
## letter, so it cannot wake its skill.
func get_enemy_skill_for_letter(letter: String) -> Dictionary:
	var want: String = letter.to_upper()
	if want == "" or want == "?":
		return {}
	for skill in enemy_skills:
		if str(skill.get("letter", "")) == want:
			return skill
	return {}


## The set of letters this enemy has bound a skill to, upper-cased.
## The shared reels deal exactly one card per entry, and no card carrying one of
## these letters ever enters the player's deck, hand or graveyard.
func _enemy_skill_letters() -> Dictionary:
	var out: Dictionary = {}
	for skill in enemy_skills:
		var letter: String = str(skill.get("letter", ""))
		if letter != "":
			out[letter] = true
	return out


## True when `letter` is one of the current enemy's skill letters. Wildcards ("?")
## are never skill letters, exactly like get_enemy_skill_for_letter().
func is_enemy_skill_letter(letter: String) -> bool:
	return _enemy_skill_letters().has(letter.to_upper())


## Whether this enemy currently has the skill with that id.
func _has_enemy_skill(id: String) -> bool:
	for skill in enemy_skills:
		if str(skill.get("id", "")) == id:
			return true
	return false


## Applies the skill if its card is in the firing line. Called at NIGHT only
## (apply_turn_start_penalty), and skipped when the stage was just cleared — a
## fallen enemy never answers back.
## Returns {fired, log, player_damage, player_absorbed} so the UI can narrate
## what happened without recomputing anything.
func _apply_skill_card_night() -> Dictionary:
	var out := {"fired": false, "log": [], "player_damage": 0, "player_absorbed": 0}
	for hit in get_skill_card_in_firing_line([]):
		var skill: Dictionary = hit["skill"]
		var id: String = str(skill.get("id", ""))
		var value: int = int(skill.get("value", 0))
		var letter: String = str(hit.get("letter", ""))
		var label: String = "%s [%s]" % [str(skill.get("name", "SKILL")), letter]
		out["fired"] = true
		match id:
			"aegis":
				enemy_shield += value
				out["log"].append("%s — enemy raises %d shield (now %d)." % [label, value, enemy_shield])
			"hand_down":
				hand_limit = maxi(ENEMY_MIN_HAND_LIMIT, hand_limit - value)
				_trim_hand_to_limit()
				out["log"].append("%s — your hand now holds at most %d cards." % [label, hand_limit])
			"drain":
				var drained: int = mini(operation_points, value)
				operation_points -= drained
				out["log"].append("%s — %d operation points drained (%d left)." % [label, drained, operation_points])
			"nightmare":
				enemy_night_tax += value
				out["log"].append("%s — NIGHT damage base +%d (now %d)." % [label, value, enemy_night_tax])
			"regrow":
				var healed: int = mini(value, enemy_max_hp - enemy_hp)
				enemy_hp += healed
				out["log"].append("%s — enemy repairs %d HP (now %d / %d)." % [label, healed, enemy_hp, enemy_max_hp])
	return out


## Sends any cards beyond the current hand limit to the graveyard. They are not
## destroyed: the graveyard is shuffled back into the draw pile, so the deck can
## never lose a card to HAND DOWN.
func _trim_hand_to_limit() -> void:
	while hand.size() > hand_limit:
		var card: Variant = hand.pop_back()
		if card != null:
			graveyard.append(card)

func _add_fallback_words() -> void:
	# Common English words as fallback for web export
	var fallback_words = [
		"the", "be", "to", "of", "and", "a", "in", "that", "have", "i",
		"it", "for", "not", "on", "with", "he", "as", "you", "do", "at",
		"this", "but", "his", "by", "from", "they", "we", "say", "her", "she",
		"or", "an", "will", "my", "one", "all", "would", "there", "their", "what",
		"so", "up", "out", "if", "about", "who", "get", "which", "go", "me",
		"when", "make", "can", "like", "time", "no", "just", "him", "know", "take",
		"people", "into", "year", "your", "good", "some", "could", "them", "see", "other",
		"than", "then", "now", "look", "only", "come", "its", "over", "think", "also",
		"back", "after", "use", "two", "how", "our", "work", "first", "well", "way",
		"even", "new", "want", "because", "any", "these", "give", "day", "most", "us",
		"is", "are", "was", "were", "been", "has", "had", "did", "does", "done",
		"word", "game", "play", "card", "hand", "slot", "turn", "score", "point", "win",
		"red", "blue", "green", "yellow", "gold", "color", "wild", "match", "bonus", "penalty"
	]
	for word in fallback_words:
		dictionary[word] = true
	print("Fallback dictionary loaded with ", dictionary.size(), " words")

# ─── Card draw & recycle ─────────────────────────────────────────────────────
# Draws the top card of the deck. When the deck runs out, the graveyard is
# moved back into the deck and shuffled (deck & graveyard only ever hold this
# game's DECK_SIZE cards — never the full CARD_DEFS pool).
func _draw_card() -> Dictionary:
	if deck.is_empty():
		_reshuffle_graveyard()
	if deck.is_empty():
		return {"letter": "E", "damage": 1, "color": "red"} # Fallback safety
	return deck.pop_back()

# Move the graveyard back into the deck and shuffle it.
func _reshuffle_graveyard() -> void:
	deck = graveyard.duplicate()
	deck.shuffle()
	graveyard.clear()

func _refill_hand() -> void:
	# The hand never grows past the current limit, so HAND DOWN keeps biting
	# until the enemy that cast it is gone.
	for i in range(mini(hand.size(), hand_limit)):
		if hand[i] == null:
			hand[i] = _draw_card()

# ─── Card cost ─────────────────────────────────────────────────────────────────
# Every card carries a COST equal to its printed damage value. The cost is paid
# in operation points (OP), the currency earned by the YELLOW trait.
func get_card_cost(card: Variant) -> int:
	if typeof(card) != TYPE_DICTIONARY:
		return 0
	return maxi(int(card.get("damage", 0)), 0)

# OP needed to activate a card's special ability.
func get_special_cost(card: Variant) -> int:
	if not has_special_ability(card):
		return 0
	return int(card.get("special_cost", card.get("damage", 0)))

func get_special_name(card: Variant) -> String:
	if not has_special_ability(card):
		return ""
	return str(card.get("special_name", "SPECIAL"))

func get_special_desc(card: Variant) -> String:
	if not has_special_ability(card):
		return ""
	return str(card.get("special_desc", ""))

# OP still missing before this card's special can be activated.
func get_special_cost_deficit(card: Variant) -> int:
	return maxi(get_special_cost(card) - operation_points, 0)

func can_use_special_ability(card: Variant) -> bool:
	return has_special_ability(card) and operation_points >= get_special_cost(card)

# ─── Special abilities ────────────────────────────────────────────────────────
# Cards with special_id have unique active abilities.
# Activate by long-press or right-click on the special card in hand. Costs OP.
# Does not consume a turn.
func has_special_ability(card: Variant) -> bool:
	if typeof(card) != TYPE_DICTIONARY:
		return false
	return card.has("special_id") and str(card.get("special_id", "")).strip_edges() != ""

func use_special_ability(hand_index: int) -> Dictionary:
	var op_before: int = operation_points
	var result := {
		"valid": false,
		"special_id": "",
		"special_name": "",
		"cost": 0,
		"operation_points_spent": 0,
		"operation_points_before": op_before,
		"operation_points_after": operation_points,
		"discarded": [],
		"drawn": 0,
		"message": "",
		"reason": ""
	}
	if hand_index < 0 or hand_index >= hand.size():
		result["reason"] = "No card in hand"
		return result
	var special_card: Dictionary = hand[hand_index]
	if not has_special_ability(special_card):
		result["reason"] = "No special ability"
		return result

	var cost: int = get_special_cost(special_card)
	result["cost"] = cost
	if operation_points < cost:
		result["reason"] = "Not enough OP"
		return result
	operation_points -= cost
	result["operation_points_spent"] = cost
	result["operation_points_after"] = operation_points

	var s_id: String = str(special_card.get("special_id", ""))
	var s_name: String = get_special_name(special_card)
	result["special_id"] = s_id
	result["special_name"] = s_name

	# Special card is ALWAYS sent to the graveyard upon use
	graveyard.append(special_card)
	hand[hand_index] = null
	result["discarded"] = [special_card]
	result["drawn"] = 1

	match s_id:
		"royal_summon":
			# Q goes to graveyard, add a 'U' (1 dmg, red) card to hand in its place
			hand[hand_index] = {"letter": "U", "damage": 1, "color": "red"}
			result["message"] = "ROYAL SUMMON! Q was sent to graveyard, added 'U' (1 dmg, red) to hand."

		"zero_gravity":
			# Z goes to graveyard, gain 10 shield and nullify night penalty this turn
			shield += 10
			night_penalty_immune = true
			_refill_hand()
			result["message"] = "ZERO GRAVITY! Z was sent to graveyard. Gained 10 shield and nullified night penalty."

		"cross_multiply":
			# X goes to graveyard, double next submitted word's effects
			word_multiplier = 2
			_refill_hand()
			result["message"] = "CROSS MULTIPLY! X was sent to graveyard. Next word effects DOUBLED (2x)!"

		"jack_in_the_box":
			# J goes to graveyard, leaves a wildcard (?) in hand in its place
			hand[hand_index] = {"letter": "?", "damage": 8, "color": "green", "is_wildcard": true}
			result["message"] = "JACK IN THE BOX! J was sent to graveyard, left a wildcard (?) in hand!"

		"spark":
			# E goes to graveyard, deal 4 direct damage to the enemy
			_apply_damage(4)
			_refill_hand()
			result["message"] = "SPARK! E was sent to graveyard. Dealt 4 direct damage to the enemy."

		"guard":
			# S goes to graveyard, gain 4 shield
			shield += 4
			_refill_hand()
			result["message"] = "GUARD! S was sent to graveyard. Gained 4 shield."

		"mini_heal":
			# A goes to graveyard, restore 4 HP
			var healed: int = mini(4, player_max_hp - player_hp)
			player_hp += healed
			_refill_hand()
			result["message"] = "MINI HEAL! A was sent to graveyard. Restored %d HP." % healed

		"cycle":
			# T goes to graveyard, draw a new card
			_refill_hand()
			result["message"] = "CYCLE! %s was sent to graveyard and drew a new card." % special_card.get("letter", "T")

		"discard_draw":
			# D goes to graveyard (already done above), discard 1 more random card, draw 2
			var other_indices: Array = []
			for i in range(hand.size()):
				if i != hand_index and hand[i] != null:
					other_indices.append(i)
			if other_indices.size() > 0:
				other_indices.shuffle()
				var discard_idx: int = other_indices[0]
				graveyard.append(hand[discard_idx])
				hand[discard_idx] = null
			_refill_hand()
			result["message"] = "DISCARD & DRAW! D + 1 card sent to graveyard, drew 2 new cards."

		"vowel_shift":
			# O goes to graveyard, replace with a random vowel (A, E, I, U)
			var vowels: Array = ["A", "E", "I", "U"]
			vowels.shuffle()
			var new_l: String = vowels[0]
			hand[hand_index] = {"letter": new_l, "damage": 1, "color": "green"}
			result["message"] = "VOWEL SHIFT! O was sent to graveyard, generated '%s' in hand." % new_l

		_:
			# Fallback
			_refill_hand()
			result["message"] = "Special activated! %s was sent to graveyard." % special_card.get("letter", "?")

	result["valid"] = true
	return result

# ─── Slot helpers ────────────────────────────────────────────────────────────
func get_slot_cards(slot_idx: int) -> Array:
	if slot_idx < slots.size():
		return slots[slot_idx]
	return []

func get_current_slot_card(slot_idx: int) -> Dictionary:
	var s_cards: Array = slots[slot_idx]
	var cur_i: int = current_slot_indices[slot_idx] % s_cards.size()
	return s_cards[cur_i]

func get_current_slot_chars() -> Array:
	var chars: Array = []
	for s in range(NUM_SLOTS):
		chars.append(get_current_slot_card(s)["letter"].to_upper())
	return chars

func get_current_slot_total_damage() -> int:
	var total: int = 0
	for s in range(NUM_SLOTS):
		total += get_current_slot_card(s)["damage"]
	return total

# Penalty preview for the NIGHT phase, computed from the NEXT card of every
# slot. `rotating_slots` lists the slots the pending submission will consume:
# those reels roll BEFORE the penalty is resolved, so their NEXT card sits one
# step further along than an untouched slot's. Passing an empty array gives the
# current (already-rolled) state, which is what the live game applies.
func get_next_slot_penalty_with_multiplier(rotating_slots: Array = []) -> Dictionary:
	var total: int = 0
	var next_cards: Array = []
	for s in range(NUM_SLOTS):
		var s_cards: Array = slots[s]
		var cur_i: int = current_slot_indices[s] % s_cards.size()
		var rolls: bool = rotating_slots.has(s)
		# An unused slot advances by 1 (NEXT of the current reel position); a used
		# slot first rolls, so its NEXT card is 2 steps from where it stands now.
		var next_i: int = (cur_i + (2 if rolls else 1)) % s_cards.size()
		var next_card: Dictionary = s_cards[next_i].duplicate()
		next_card["type"] = "slot"
		next_card["index"] = s
		next_card["will_rotate"] = rolls
		next_cards.append(next_card)
		total += next_card["damage"]

	var multiplier: int = calculate_penalty_color_multiplier(next_cards)
	# NIGHTMARE thickens the night: the tax is added to the BASE, so the steep
	# same-color multiplier still scales it. It is cleared with the enemy.
	var taxed_base: int = total + enemy_night_tax
	return {
		"base_penalty": taxed_base,
		"slot_penalty": total,
		"night_tax": enemy_night_tax,
		"multiplier": multiplier,
		"final_penalty": taxed_base * multiplier,
		"next_cards": next_cards
	}

func rotate_slots(used_slots: Array) -> void:
	# Rotate only the slots that were used (the card on the ACTIVE row moves out
	# and the NEXT card becomes ACTIVE)
	for s in used_slots:
		if int(s) < 0 or int(s) >= current_slot_indices.size():
			continue
		current_slot_indices[s] = (current_slot_indices[s] + 1) % CARDS_PER_SLOT


# ─── OP ability: spin a shared reel ──────────────────────────────────────────
# SPIN_COST OP advances ONE shared reel by one step, so the card that was showing
# as NEXT becomes ACTIVE. Each reel is spun independently, so a player can nudge
# one bad reel and leave the others alone.
const SPIN_COST: int = 1

# Which reels currently have their ACTIVE card on the Workbench. The UI owns the
# Workbench, so it reports this back here.
var slot_in_use: Array = []


## What spinning reel `slot_idx` right now would do, without doing it.
## Used by the UI to label the buttons and to grey them out when spinning is
## not allowed, so the rules are never hidden from the player.
func can_spin_slot(slot_idx: int) -> Dictionary:
	if slot_idx < 0 or slot_idx >= slots.size():
		return {"ok": false, "reason": "No such reel"}
	if slot_idx >= current_slot_indices.size():
		return {"ok": false, "reason": "Reel is not ready"}
	if operation_points < SPIN_COST:
		return {"ok": false, "reason": "Not enough OP"}
	# Spinning a reel whose ACTIVE card is already part of the word being built
	# would silently change the word, so it is refused. The player must remove
	# the card from the Workbench first.
	if is_slot_active_in_use(slot_idx):
		return {"ok": false, "reason": "That card is in your word"}
	return {"ok": true, "reason": ""}


## Whether the reel's ACTIVE card is currently placed on the Workbench. The UI
## owns the Workbench, so it reports this back to the game logic.
func set_slot_in_use(slot_idx: int, in_use: bool) -> void:
	while slot_in_use.size() < slots.size():
		slot_in_use.append(false)
	if slot_idx >= 0 and slot_idx < slot_in_use.size():
		slot_in_use[slot_idx] = in_use


func is_slot_active_in_use(slot_idx: int) -> bool:
	return slot_idx >= 0 and slot_idx < slot_in_use.size() and slot_in_use[slot_idx]


## Spends OP to advance one reel by a single step. Returns what happened so the
## UI can report it. The OP are only spent when the spin actually happens, so a
## refused spin never costs anything.
func spin_slot(slot_idx: int) -> Dictionary:
	var check: Dictionary = can_spin_slot(slot_idx)
	if not check.get("ok", false):
		return {"ok": false, "reason": check.get("reason", "Cannot spin")}

	var spend: Dictionary = try_spend_operation_points(SPIN_COST)
	if not spend.get("valid", false):
		return {"ok": false, "reason": spend.get("reason", "Not enough OP")}

	var s_cards: Array = slots[slot_idx]
	var cur_i: int = current_slot_indices[slot_idx] % s_cards.size()
	var next_i: int = (cur_i + 1) % s_cards.size()
	current_slot_indices[slot_idx] = next_i

	var shown: Dictionary = s_cards[next_i]
	return {
		"ok": true,
		"slot": slot_idx,
		"card": shown,
		"remaining": spend.get("remaining", operation_points),
		"message": "Spun reel %d for %d OP — now showing %s (%d dmg, %s). %d OP left." % [
			slot_idx + 1, SPIN_COST, shown.get("letter", "?"),
			int(shown.get("damage", 0)),
			str(shown.get("color", "red")).to_upper(),
			int(spend.get("remaining", operation_points))]
	}

# Calculate the word-damage color multiplier. RED is exceptional:
# 0 red = x1, 1 red = x1.5 (exception), 2+ red = 2^(n-1)
# (2 red = 2x, 3 red = 4x, 4 red = 8x, etc.). Blue/green/yellow same-color
# groups do NOT multiply damage — those colors grant their traits instead.
func calculate_color_multiplier(assignment: Array) -> float:
	var red_count: int = int(count_colors_in_assignment(assignment).get("red", 0))
	return red_damage_multiplier(red_count)

# Stacking multiplier shared by BLUE/GREEN/YELLOW traits:
# 0 cards -> 0 (trait inactive), 1 -> x1, 2 -> x2, 3 -> x4, 4 -> x8
func color_trait_multiplier(card_count: int) -> int:
	if card_count <= 0:
		return 0
	return int(pow(2, card_count - 1))

# RED's word-damage multiplier follows the exceptional rule:
# 0 red -> x1, exactly 1 red -> x1.5, 2+ red -> 2^(n-1)
func red_damage_multiplier(red_count: int) -> float:
	if red_count <= 0:
		return 1.0
	if red_count == 1:
		return 1.5
	return pow(2, red_count - 1)

# Calculate penalty color multiplier for night phase self-damage (2+ same color = 10x, 3 = 100x, 4 = 1000x, etc.)
# Note: Word damage bonuses still use calculate_color_multiplier(); only night self-damage uses this steeper multiplier.
func calculate_penalty_color_multiplier(assignment: Array) -> int:
	var color_counts: Dictionary = {}
	for src in assignment:
		var color: String = src.get("color", "red")
		if color_counts.has(color):
			color_counts[color] += 1
		else:
			color_counts[color] = 1

	var max_count: int = 0
	for color in color_counts:
		if color_counts[color] > max_count:
			max_count = color_counts[color]

	# Penalty multiplier: 2 cards = 10x, 3 cards = 100x, 4 cards = 1000x, etc. (10^(n-1))
	if max_count < 2:
		return 1
	return int(pow(10, max_count - 1))

# ─── Word Subsequence Search & Validation ────────────────────────────────────
# Validates words with strict left-to-right slot ordering, filled with hand cards.
func find_valid_assignments(word: String) -> Array:
	var result: Array = []
	if word == "":
		return result

	var word_lower = word.to_lower()

	# If word contains wildcard "?", search for matching dictionary words
	if "?" in word_lower:
		for dict_word in dictionary.keys():
			if _matches_pattern(dict_word, word_lower):
				var chars: Array = dict_word.to_upper().split("")
				var slot_chars: Array = get_current_slot_chars()
				_search_slot_subsequences(chars, slot_chars, 0, 0, {}, result)
		return result

	# Otherwise, check if exact word exists in dictionary
	if not dictionary.has(word_lower):
		return result

	var chars: Array = word.to_upper().split("")
	var slot_chars: Array = get_current_slot_chars()

	_search_slot_subsequences(chars, slot_chars, 0, 0, {}, result)
	return result

func _matches_pattern(dict_word: String, pattern: String) -> bool:
	if dict_word.length() != pattern.length():
		return false
	for i in range(dict_word.length()):
		var p_char = pattern[i]
		if p_char != "?" and p_char != dict_word[i]:
			return false
	return true

func _search_slot_subsequences(chars: Array, slot_chars: Array, word_idx: int, min_slot_idx: int, current_slot_map: Dictionary, results: Array) -> void:
	# Try matching remaining letters with available hand cards
	var hand_assignments: Array = []
	_assign_hand_cards(chars, current_slot_map, 0, [], hand_assignments)
	for h_assign in hand_assignments:
		var full_assign: Array = []
		for i in range(chars.size()):
			if current_slot_map.has(i):
				var s_idx: int = current_slot_map[i]
				var card: Dictionary = get_current_slot_card(s_idx)
				var is_wildcard: bool = card["letter"] == "?"
				full_assign.append({
					"type": "slot",
					"index": s_idx,
					"char": chars[i],  # The actual character this position represents
					"card_letter": card["letter"],  # The actual letter on the card
					"is_wildcard": is_wildcard,
					"damage": card["damage"],
					"color": card.get("color", "red")
				})
			else:
				var h_idx: int = h_assign[i]
				var card: Dictionary = hand[h_idx]
				var is_wildcard: bool = card["letter"] == "?"
				full_assign.append({
					"type": "hand",
					"hand_index": h_idx,
					"char": chars[i],  # The actual character this position represents
					"card_letter": card["letter"],  # The actual letter on the card
					"is_wildcard": is_wildcard,
					"damage": card["damage"],
					"color": card.get("color", "red")
				})
		results.append(full_assign)

	# Branch: include more slots in strictly increasing index order
	for w in range(word_idx, chars.size()):
		for s in range(min_slot_idx, slot_chars.size()):
			# Wildcard "?" matches any character
			if chars[w] == slot_chars[s] or slot_chars[s] == "?":
				current_slot_map[w] = s
				_search_slot_subsequences(chars, slot_chars, w + 1, s + 1, current_slot_map, results)
				current_slot_map.erase(w)

func _assign_hand_cards(chars: Array, slot_map: Dictionary, char_idx: int, used_hand_indices: Array, results: Array) -> void:
	if char_idx >= chars.size():
		var mapping: Dictionary = {}
		for u in used_hand_indices:
			mapping[u["char_idx"]] = u["hand_idx"]
		results.append(mapping)
		return

	if slot_map.has(char_idx):
		_assign_hand_cards(chars, slot_map, char_idx + 1, used_hand_indices, results)
		return

	var target_char: String = chars[char_idx]
	var already_used_h: Array = []
	for u in used_hand_indices:
		already_used_h.append(u["hand_idx"])

	for h in range(hand.size()):
		# Wildcard "?" matches any character
		if hand[h] != null and (hand[h]["letter"] == target_char or hand[h]["letter"] == "?") and h not in already_used_h:
			used_hand_indices.append({"char_idx": char_idx, "hand_idx": h})
			_assign_hand_cards(chars, slot_map, char_idx + 1, used_hand_indices, results)
			used_hand_indices.pop_back()

# Feasibility check
func validate_word(word: String) -> Dictionary:
	var result := {"valid": false, "message": "INVALID", "assignment": []}
	var valid_assignments: Array = find_valid_assignments(word)
	if valid_assignments.size() > 0:
		result["valid"] = true
		result["message"] = "VALID: %s" % word.to_upper()
		result["assignment"] = valid_assignments[0]
		result["all_assignments"] = valid_assignments
	return result

func is_assignment_valid(word: String, assignment: Array) -> bool:
	if assignment.size() != word.length():
		return false
	var chars: Array = word.to_upper().split("")
	var slot_chars: Array = get_current_slot_chars()
	var used_hand: Array = []
	var last_slot_idx: int = -1

	for i in range(assignment.size()):
		var src = assignment[i]
		if src == null:
			return false
		var ch: String = chars[i]
		if src["type"] == "hand":
			var hi: int = src["hand_index"]
			var card_letter: String = src.get("card_letter", hand[hi]["letter"])
			# Wildcard "?" matches any character
			if hi in used_hand or hand[hi] == null:
				return false
			# If card is wildcard, it matches any character
			if card_letter != "?" and card_letter != ch:
				return false
			used_hand.append(hi)
		elif src["type"] == "slot":
			var si: int = src["index"]
			var card_letter: String = src.get("card_letter", slot_chars[si])
			# Wildcard "?" matches any character
			if si <= last_slot_idx or si >= slot_chars.size():
				return false
			# If card is wildcard, it matches any character
			if card_letter != "?" and card_letter != ch:
				return false
			last_slot_idx = si
	return true

# ─── Execute confirmed assignment ────────────────────────────────────────────
func execute_assignment(word: String, assignment: Array) -> Dictionary:
	var used_hand_indices: Array = []
	var used_slot_indices: Array = []
	var base_damage: int = 0

	for src in assignment:
		base_damage += src.get("damage", 0)
		if src["type"] == "hand":
			used_hand_indices.append(src["hand_index"])
		else:
			used_slot_indices.append(src["index"])

	var enemy_hp_before: int = enemy_hp
	var enemy_max_hp_before: int = enemy_max_hp
	var player_hp_before: int = player_hp
	var defeated_before: int = enemies_defeated
	var enemy_name_before: String = enemy_name
	# ─── Accessors ───────────────────────────────────────────────────────────────
	var multiplier: float = calculate_color_multiplier(assignment)
	var color_counts: Dictionary = count_colors_in_assignment(assignment)
	var active_w_mult: int = word_multiplier
	word_multiplier = 1

	# RED trait (attack multiplier), applied EXACTLY ONCE:
	#   0 red = x1 (no effect), exactly 1 red = x1.5 (exception),
	#   2+ red = base x 2^(red - 1). The multiplier is NOT stacked with
	# any further per-card bonus.
	var group_damage: int = int(round(base_damage * multiplier)) * active_w_mult
	var final_damage: int = group_damage

	for hi in used_hand_indices:
		graveyard.append(hand[hi])
		hand[hi] = null
	_refill_hand()
	rotate_slots(used_slot_indices)

	# Color traits resolve BEFORE the damage exchange. Every trait is based on the
	# BASE TOTAL with the same stacking multiplier 2^(count - 1):
	#   BLUE  -> shield = base x 2^(blue - 1)   (no cap)
	#   GREEN -> heal   = base x 2^(green - 1)  (capped at max HP)
	#   YELLOW is reserved for a future trait
	var blue_count: int = int(color_counts.get("blue", 0))
	var green_count: int = int(color_counts.get("green", 0))
	var yellow_count: int = int(color_counts.get("yellow", 0))
	# A negative word deals no trait value, so traits scale off the positive base
	var trait_base: int = maxi(base_damage, 0)
	var shield_before: int = shield
	var shield_mult: int = color_trait_multiplier(blue_count)
	var shield_gained: int = trait_base * shield_mult * active_w_mult
	shield += shield_gained
	var heal_mult: int = color_trait_multiplier(green_count)
	var heal_amount: int = mini(trait_base * heal_mult * active_w_mult, player_max_hp - player_hp)
	player_hp += heal_amount
	# YELLOW: earn operation points (same base-scaled stacking). Points accumulate
	# and can be spent to move a card on the Workbench.
	var operation_points_before: int = operation_points
	var yellow_mult: int = color_trait_multiplier(yellow_count)
	var operation_points_gained: int = trait_base * yellow_mult * active_w_mult
	operation_points += operation_points_gained
	var player_hp_after_traits: int = player_hp

	# Positive damage is dealt to the enemy, negative damage hurts the player
	# (the BLUE shield absorbs incoming damage first)
	var damage_result: Dictionary = _apply_damage(final_damage)

	# Defeating an enemy ends the fight, so this turn's NIGHT self-damage is
	# nullified (see apply_turn_start_penalty). The flag is one-shot.
	var defeated_delta: int = enemies_defeated - defeated_before
	stage_cleared_immune = defeated_delta > 0

	# ── Enemy skill ─────────────────────────────────────────────────────────────
	# The skill no longer fires on submit. It is a CARD that answers at NIGHT
	# while it sits in a reel's bottom row (see apply_turn_start_penalty), so
	# nothing happens here — the reels have not rotated yet at this point.
	var enemy_shield_before: int = enemy_shield
	var enemy_hp_after_damage: int = enemy_hp
	var hand_limit_before: int = hand_limit
	var night_tax_before: int = enemy_night_tax
	var enemy_skill_log: Array = []
	var enemy_skill_damage: int = 0
	var enemy_skill_absorbed: int = 0

	turn += 1
	is_night = not is_night

	return {
		"message": "VALID: %s" % word.to_upper(),
		"word_damage": base_damage,
		"multiplier": multiplier,
		"group_damage": group_damage,
		"red_bonus": group_damage - base_damage,
		"shield_before": shield_before,
		"shield_gained": shield_gained,
		"shield_mult": shield_mult,
		"heal_amount": heal_amount,
		"heal_mult": heal_mult,
		"operation_points_before": operation_points_before,
		"operation_points_gained": operation_points_gained,
		"operation_points_after": operation_points,
		"yellow_mult": yellow_mult,
		"player_hp_after_traits": player_hp_after_traits,
		"self_damage_absorbed": damage_result.get("absorbed", 0),
		"self_damage_taken": damage_result.get("taken", 0),
		"final_damage": final_damage,
		"enemy_shield_before": enemy_shield_before,
		"enemy_shield_absorbed": int(damage_result.get("enemy_shield_absorbed", 0)),
		"enemy_shield_after": enemy_shield,
		"enemy_hp_damage": int(damage_result.get("enemy_hp_damage", 0)),
		"enemy_hp_after_damage": enemy_hp_after_damage,
		"enemy_skill_log": enemy_skill_log,
		"enemy_skill_damage": enemy_skill_damage,
		"enemy_skill_absorbed": enemy_skill_absorbed,
		"enemy_skill_heal": maxi(enemy_hp - enemy_hp_after_damage, 0),
		"enemy_skill_night_tax": maxi(enemy_night_tax - night_tax_before, 0),
		"hand_limit_before": hand_limit_before,
		"hand_limit_after": hand_limit,
		"enemy_hp_before": enemy_hp_before,
		"enemy_hp_after": enemy_hp,
		"enemy_max_hp_before": enemy_max_hp_before,
		"enemy_max_hp_after": enemy_max_hp,
		"player_hp_before": player_hp_before,
		"player_hp_after": player_hp,
		"enemies_defeated_delta": enemies_defeated - defeated_before,
		"used_hand": used_hand_indices,
		"used_slots": used_slot_indices,
		"turn": turn,
		"stage": stage,
		"enemy_name_before": enemy_name_before,
		"phase": get_phase(),
		"game_over": game_over,
		"game_outcome": game_outcome
	}


# Spend operation points to perform a player action. Actions never consume a
# turn; invalid actions are rejected without spending points.
func spend_operation_points(amount: int) -> bool:
	if amount <= 0:
		return false
	if operation_points < amount:
		return false
	operation_points -= amount
	return true

# ─── Damage resolution ───────────────────────────────────────────────────────
# Positive damage hits the current enemy. The enemy's AEGIS shield soaks damage
# before any HP is lost, and only what gets through lowers the HP. When the HP
# reaches 0 the stage is cleared (stronger enemy + fresh hand) and EVERY effect
# the fallen enemy granted is wiped. Any excess damage is LOST — it does NOT
# carry over to the next stage's enemy.
# Negative damage hits the player instead: the BLUE shield absorbs first, then
# HP (never below 0). Returns {absorbed, taken}.
func _apply_damage(amount: int) -> Dictionary:
	if amount > 0:
		total_damage += amount
		# AEGIS soaks the hit first; only the remainder reaches the enemy HP.
		var soaked: int = mini(enemy_shield, amount)
		enemy_shield -= soaked
		var to_hp: int = amount - soaked
		enemy_hp -= to_hp
		if enemy_hp <= 0:
			_advance_stage()
		return {"absorbed": 0, "taken": 0, "enemy_shield_absorbed": soaked, "enemy_hp_damage": to_hp}
	elif amount < 0:
		return _take_self_damage(-amount)
	return {"absorbed": 0, "taken": 0}

# Applies damage to the player: shield absorbs first, then HP (HP >= 0).
func _take_self_damage(amount: int) -> Dictionary:
	var absorbed: int = mini(shield, amount)
	shield -= absorbed
	var taken: int = amount - absorbed
	player_hp = maxi(player_hp - taken, 0)
	_check_player_defeat()
	return {"absorbed": absorbed, "taken": taken}

# Count how many cards of each color are used in the word.
func count_colors_in_assignment(assignment: Array) -> Dictionary:
	var counts: Dictionary = {"red": 0, "blue": 0, "green": 0, "yellow": 0}
	for src in assignment:
		var c: String = src.get("color", "red")
		counts[c] = counts.get(c, 0) + 1
	return counts

# ─── Stage progression ────────────────────────────────────────────────────────
# Defeating an enemy advances to the next stage: a stronger enemy with a NEW
# random name appears, the player's hand is redrawn and the shared reels are
# rebuilt from the new enemy's name letters.
# Any excess damage that killed the enemy is lost (no carry-over).
func _advance_stage() -> void:
	enemies_defeated += 1
	stage += 1
	# The fallen enemy takes every one of its effects with it: the hand limit is
	# restored, its shield and night tax are dropped and its skill letters are
	# erased. Only the next enemy's name rebuilds the board from scratch.
	_clear_enemy_skills()
	enemy_max_hp += ENEMY_HP_GROWTH
	enemy_hp = enemy_max_hp
	enemy_name = _roll_enemy_name()
	_roll_enemy_skills()
	# The hand is NOT redrawn yet. Defering it keeps the cards the player was
	# actually holding on the board while the reward is offered, so the BURN A
	# CARD picker shows those real cards (and the whole deck) instead of a fresh
	# hand that replaced them. The redraw happens in flush_pending_hand_redraw()
	# once the reward has been resolved.
	hand_redraw_pending = true
	_build_shared_slots()


## Draws the fresh hand for the new stage, but only if one is still owed.
## Called after the reward has been taken (or skipped), never before, so the
## player can still see and burn the hand they finished the fight with.
func flush_pending_hand_redraw() -> void:
	if not hand_redraw_pending:
		return
	hand_redraw_pending = false
	_reset_hand()


# Discard the whole hand and draw a fresh one, up to the current hand limit.
func _reset_hand() -> void:
	for i in range(hand.size()):
		if hand[i] != null:
			graveyard.append(hand[i])
			hand[i] = null
	while hand.size() < hand_limit:
		hand.append(null)
	_trim_hand_to_limit()
	_refill_hand()

# Rebuild the shared slot reels (3x3) from the current enemy's name letters,
# in SHUFFLED order (the name's sequence is randomized across the9 positions),
# then rewind the reels to the top. The shared cards come from their own copy
# of the card pool — they are NOT part of the player's deck, and cards spent
# here never enter the player's graveyard.
# Cards the name cannot cover (or pool shortages) are drawn at random from
# the shared pool.
# A letter the enemy bound a skill to is dealt EXACTLY ONCE, so every skill has
# a single, obvious source of danger on the board.
func _build_shared_slots() -> void:
	# Letters this enemy bound a skill to. Kept out of the filler draw below and
	# de-duplicated in the name pass, so each one reaches the reels exactly once.
	var skill_letters: Dictionary = _enemy_skill_letters()

	var pool: Array = []
	for def in CARD_DEFS:
		pool.append(def.duplicate())

	# The enemy name's letters (their positions are shuffled below)
	var name_letters: Array = []
	for ch in enemy_name.to_upper():
		if ALPHA.find(ch) >= 0:
			name_letters.append(ch)

	var cards: Array = []
	# 1) Use the enemy name's letters first. A skill letter is kept only the
	# FIRST time it shows up, so each skill is represented by exactly one card
	# however many times the letter repeats in the name.
	var used_skill_letters: Dictionary = {}
	while cards.size() < NUM_SLOTS * CARDS_PER_SLOT and not name_letters.is_empty():
		var wanted: String = name_letters.pop_front()
		var is_skill: bool = skill_letters.has(wanted)
		if is_skill and used_skill_letters.has(wanted):
			continue # Already dealt this skill letter once; skip the extra copies
		var found_idx: int = _find_random_letter_index(pool, wanted)
		if found_idx >= 0:
			cards.append(pool[found_idx])
			pool.remove_at(found_idx)
			if is_skill:
				used_skill_letters[wanted] = true
		# If the shared pool has no copy left, the letter is simply skipped

	# 2) Fill the rest with random draws from the shared pool. Skill letters are
	# never used here either, so the one-card-per-skill rule holds no matter how
	# much filler the reels need.
	while cards.size() < NUM_SLOTS * CARDS_PER_SLOT and not pool.is_empty():
		var candidates: Array = []
		for i in range(pool.size()):
			if not skill_letters.has(str(pool[i].get("letter", ""))):
				candidates.append(i)
		if candidates.is_empty():
			break
		var random_idx: int = candidates[randi() % candidates.size()]
		cards.append(pool[random_idx])
		pool.remove_at(random_idx)

	# Safety: never deal fewer than NUM_SLOTS * CARDS_PER_SLOT cards
	while cards.size() < NUM_SLOTS * CARDS_PER_SLOT:
		cards.append({"letter": "?", "damage": 0, "color": "gold"})

	# Shuffle so the shared cards are NOT dealt in the enemy name's order
	cards.shuffle()

	slots.clear()
	current_slot_indices = []
	var pos: int = 0
	for s in range(NUM_SLOTS):
		var slot_cards: Array = []
		for _c in range(CARDS_PER_SLOT):
			slot_cards.append(cards[pos])
			pos += 1
		slots.append(slot_cards)
		current_slot_indices.append(0)

# Pick a random pool entry with the given letter (any color), or -1 if none.
func _find_random_letter_index(pool: Array, letter: String) -> int:
	var matches: Array = []
	for i in range(pool.size()):
		if pool[i].get("letter", "") == letter:
			matches.append(i)
	if matches.is_empty():
		return -1
	return matches[randi() % matches.size()]

func _check_player_defeat() -> void:
	if player_hp <= 0 and not game_over:
		game_over = true
		game_outcome = "DEFEAT"

