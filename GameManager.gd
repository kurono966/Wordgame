# ─── Submit preview ───────────────────────────────────────────────────────────
# Predicts EVERYTHING the player will take when submitting `assignment`, without
# mutating any state. It mirrors the real resolution order exactly:
#   1. BLUE shield and GREEN heal from the word are granted first
#   2. negative word damage hits the player (BLUE shield absorbs it)
#   3. the word damages the enemy — its AEGIS shield soaks the hit first
#   4. if the enemy SURVIVES, every skill letter in the word fires back
#   5. the turn counter advances and the phase flips
#   6. if the new phase is NIGHT, the slot penalty lands (BLUE shield absorbs it)
# Slots listed in `used_slots` roll in step 5, so step 6 reads their NEXT card
# one position further along — see get_next_slot_penalty_with_multiplier().
func predict_submit_outcome(assignment: Array, used_slots: Array) -> Dictionary:
	var base_damage: int = 0
	for src in assignment:
		base_damage += int(src.get("damage", 0))

	var multiplier: float = calculate_color_multiplier(assignment)
	var color_counts: Dictionary = count_colors_in_assignment(assignment)
	var active_w: int = word_multiplier
	var final_damage: int = int(round(float(base_damage) * multiplier)) * active_w

	# 1) Traits resolve before the damage exchange (positive base only)
	var trait_base: int = maxi(base_damage, 0)
	var shield_gained: int = trait_base * color_trait_multiplier(int(color_counts.get("blue", 0))) * active_w
	var heal_mult: int = color_trait_multiplier(int(color_counts.get("green", 0)))
	var heal_amount: int = mini(trait_base * heal_mult * active_w, player_max_hp - player_hp)
	var shield_pool: int = shield + shield_gained
	var hp_pool: int = player_hp + heal_amount

	# 2) Negative word damage hurts the player; the shield absorbs it first
	var word_self_damage: int = maxi(-final_damage, 0)
	var word_absorbed: int = mini(shield_pool, word_self_damage)
	shield_pool -= word_absorbed
	hp_pool = maxi(hp_pool - (word_self_damage - word_absorbed), 0)

	# 3) The word hits the enemy, but AEGIS soaks the damage before its HP does
	var enemy_shield_pool: int = enemy_shield
	var enemy_shield_absorbed: int = mini(enemy_shield_pool, maxi(final_damage, 0))
	enemy_shield_pool -= enemy_shield_absorbed
	var enemy_hp_damage: int = maxi(final_damage, 0) - enemy_shield_absorbed
	var enemy_hp_pool: int = maxi(enemy_hp - enemy_hp_damage, 0)

	# Killing the enemy ends the fight, so this turn's NIGHT self-damage is
	# nullified — the preview must show the same 0 the real submit will charge —
	# and no enemy skill fires back.
	var defeats_enemy: bool = final_damage > 0 and enemy_hp_pool <= 0

	# 5) The turn advances and the phase flips
	var next_is_night: bool = not is_night

	# 6) On the new NIGHT phase the slot penalty lands (used slots already rolled)
	var penalty: Dictionary = get_next_slot_penalty_with_multiplier(used_slots if next_is_night else [])
	var penalty_immune: bool = night_penalty_immune or defeats_enemy
	var night_base: int = int(penalty["base_penalty"])
	var night_multi: int = int(penalty["multiplier"])
	var night_penalty: int = (0 if penalty_immune else night_base * night_multi) if next_is_night else 0
	var night_absorbed: int = mini(shield_pool, night_penalty)
	shield_pool -= night_absorbed
	hp_pool = maxi(hp_pool - (night_penalty - night_absorbed), 0)

	# 7) The skill card answers at NIGHT while it sits in a reel's BOTTOM row.
	# Predict it on throwaway numbers, using the reels' POST-ROTATION positions so
	# the forecast can never drift from what the real night does. A stage clear
	# ends the fight, so nothing fires then.
	var rotating_for_night: Array = used_slots if next_is_night else []
	var skills: Dictionary = _preview_skill_card_night(
		rotating_for_night, shield_pool, hp_pool, enemy_hp_pool) if (next_is_night and not defeats_enemy) else {
		"log": [], "player_damage": 0, "player_absorbed": 0,
		"enemy_shield": 0, "enemy_heal": 0, "night_tax": 0,
		"shield_after": shield_pool, "hp_after": hp_pool,
	}
	var enemy_skill_log: Array = skills["log"]
	var skill_damage: int = int(skills["player_damage"])
	var skill_absorbed: int = int(skills["player_absorbed"])
	var skill_heal: int = int(skills["enemy_heal"])
	var skill_night_tax: int = int(skills["night_tax"])
	shield_pool = int(skills["shield_after"])
	hp_pool = int(skills["hp_after"])
	enemy_shield_pool += int(skills["enemy_shield"])
	enemy_hp_pool += skill_heal

	var hp_lost: int = maxi((player_hp + heal_amount) - hp_pool, 0)
	return {
		"base_damage": base_damage,
		"multiplier": multiplier,
		"final_damage": final_damage,
		"color_counts": color_counts,
		"shield_gained": shield_gained,
		"heal_amount": heal_amount,
		"word_self_damage": word_self_damage,
		"word_absorbed": word_absorbed,
		"next_is_night": next_is_night,
		"night_base_penalty": penalty["base_penalty"],
		"night_multiplier": penalty["multiplier"],
		"night_penalty": night_penalty,
		"night_absorbed": night_absorbed,
		"night_next_cards": penalty["next_cards"],
		"night_penalty_immune": penalty_immune,
		"defeats_enemy": defeats_enemy,
		"total_absorbed": word_absorbed + skill_absorbed + night_absorbed,
		"total_hp_lost": hp_lost,
		"player_hp_after": hp_pool,
		"lethal": hp_pool <= 0 and (player_hp + heal_amount) > 0,
		# The enemy side, so the forecast can spell out what its skills will do.
		"enemy_shield_before": enemy_shield,
		"enemy_shield_absorbed": enemy_shield_absorbed,
		"enemy_shield_after": enemy_shield_pool,
		"enemy_hp_damage": enemy_hp_damage,
		"enemy_hp_after": enemy_hp_pool,
		"enemy_skills_fire": enemy_skill_log.size() > 0,
		"enemy_skill_log": enemy_skill_log,
		"enemy_skill_damage": skill_damage,
		"enemy_skill_absorbed": skill_absorbed,
		"enemy_skill_heal": skill_heal,
		"enemy_skill_night_tax": skill_night_tax
	}

func get_turn() -> int:
	return turn

func get_phase() -> String:
	return "NIGHT" if is_night else "DAY"

func get_next_slot_total_penalty() -> int:
	if night_penalty_immune or stage_cleared_immune:
		return 0
	return get_next_slot_penalty_with_multiplier()["final_penalty"]

func apply_turn_start_penalty() -> Dictionary:
	# Defeating an enemy ends the fight, so the NIGHT self-damage of THAT turn is
	# skipped. The immunity is one-shot, so it is consumed here either way.
	var stage_cleared: bool = stage_cleared_immune
	stage_cleared_immune = false

	if not is_night:
		# A DAY turn never resolves a night, so the skill cannot fire. The keys are
		# still present so callers can read one consistent shape.
		return {
			"base_damage": 0,
			"multiplier": 1,
			"requested_damage": 0,
			"absorbed": 0,
			"applied_damage": 0,
			"stage_cleared": stage_cleared,
			"previous_player_hp": player_hp,
			"player_hp": player_hp,
			"skill_fired": false,
			"skill_log": [],
			"skill_damage": 0,
			"skill_absorbed": 0
		}

	var penalty: Dictionary = get_next_slot_penalty_with_multiplier()
	var requested_damage: int = penalty["final_penalty"]
	if night_penalty_immune or stage_cleared:
		requested_damage = 0
	night_penalty_immune = false
	var previous_player_hp: int = player_hp
	# Night self-damage: the BLUE shield absorbs first, then HP
	var damage_result: Dictionary = _take_self_damage(requested_damage)

	# The skill card answers back at NIGHT while it sits in a reel's BOTTOM row.
	# A stage clear ends the fight, so a fallen enemy never fires.
	var skill_result: Dictionary = {"fired": false, "log": [], "player_damage": 0, "player_absorbed": 0}
	if not stage_cleared:
		skill_result = _apply_skill_card_night()

	return {
		"base_damage": penalty["base_penalty"],
		"multiplier": penalty["multiplier"],
		"requested_damage": requested_damage,
		"absorbed": damage_result["absorbed"],
		"applied_damage": previous_player_hp - player_hp,
		"stage_cleared": stage_cleared,
		"previous_player_hp": previous_player_hp,
		"player_hp": player_hp,
		"skill_fired": bool(skill_result.get("fired", false)),
		"skill_log": skill_result.get("log", []),
		"skill_damage": int(skill_result.get("player_damage", 0)),
		"skill_absorbed": int(skill_result.get("player_absorbed", 0))
	}
