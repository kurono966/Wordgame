extends Node

# Headless test for the JSON word dictionary (res://word_dictionary.json,
# generated by build_word_json.py).
#   * the JSON is the source of truth for word validation
#   * the loaded set is IDENTICAL to the legacy dictionary.txt, so switching
#     sources cannot change which words the game accepts
#   * Japanese glosses resolve, are case-insensitive, and never invent a word
#     the dictionary does not contain

const SAMPLE_WORDS: Array = [
	"aardvark", "abacus", "abandon", "abase", "abash", "abate",
	"abbreviation", "abdomen", "abduct", "ability",
]

func _ready() -> void:
	var gm = GameManager
	var fails: int = 0
	await get_tree().process_frame

	fails += _check_dictionary_loaded(gm)
	fails += _check_matches_legacy_txt(gm)
	fails += _check_sample_translations(gm)
	fails += _check_short_translations(gm)
	fails += _check_case_insensitive(gm)
	fails += _check_no_phantom_words(gm)
	fails += await _check_ui_shows_gloss(gm)
	fails += await _check_ui_real_word_flow(gm)
	fails += await _check_untranslated_shows_nothing(gm)

	print("FAILURES=%d" % fails)
	print("TEST_EXIT=%d" % fails)
	get_tree().quit(fails)

func _check_dictionary_loaded(gm: Node) -> int:
	var fails: int = 0
	fails += _check(gm.dictionary.size() > 400000,
		"the full word list is loaded (%d words)" % gm.dictionary.size())
	fails += _check(gm.word_list.size() > 200000,
		"enemy-name candidates are built (%d)" % gm.word_list.size())
	fails += _check(gm.word_translations.size() > 0,
		"translations are loaded (%d)" % gm.word_translations.size())
	return fails

## The JSON must not change which words are valid. Re-read dictionary.txt and
## compare: the ACCEPTED set is `words` + `translations` keys, because the two
## JSON sections are disjoint (a translated word lives only under "translations").
func _check_matches_legacy_txt(gm: Node) -> int:
	var fails: int = 0
	var legacy: Dictionary = {}
	var file := FileAccess.open("res://dictionary.txt", FileAccess.READ)
	if file == null:
		return _check(false, "dictionary.txt is available for comparison")
	while not file.eof_reached():
		var line := file.get_line().strip_edges()
		if line != "":
			legacy[line.to_lower()] = true
	file.close()

	fails += _check(legacy.size() == gm.dictionary.size(),
		"the accepted set matches dictionary.txt in size (%d vs %d)" % [gm.dictionary.size(), legacy.size()])

	# Spot-check both directions so a silent difference cannot hide behind size.
	var missing: int = 0
	var extra: int = 0
	for word: String in legacy:
		if not gm.dictionary.has(word):
			missing += 1
	for word: String in gm.dictionary:
		if not legacy.has(word):
			extra += 1
	fails += _check(missing == 0, "no dictionary word is missing (%d missing)" % missing)
	fails += _check(extra == 0, "no word is invented (%d extra)" % extra)

	# A translated word is stored only under "translations", yet must still be
	# accepted by the game. This is the regression that disjoint sections cause.
	fails += _check(_sections_are_disjoint(), "words and translations do not overlap")
	for word: String in gm.word_translations:
		if not gm.dictionary.has(word):
			fails += _check(false, "translated word '%s' is not accepted as a valid word" % word)
			break
	fails += _check(true, "every translated word is still a valid word in game")
	return fails


## Reads the raw JSON and asserts the two sections share no word.
func _sections_are_disjoint() -> bool:
	var file := FileAccess.open("res://word_dictionary.json", FileAccess.READ)
	if file == null:
		return false
	var parsed: Variant = JSON.parse_string(file.get_as_text())
	file.close()
	if typeof(parsed) != TYPE_DICTIONARY:
		return false
	var data: Dictionary = parsed
	var words: Dictionary = {}
	for w: Variant in data.get("words", []):
		words[str(w).to_lower()] = true
	for key: Variant in data.get("translations", {}):
		if words.has(str(key).to_lower()):
			return false
	return true

func _check_sample_translations(gm: Node) -> int:
	var fails: int = 0
	for word: String in SAMPLE_WORDS:
		var gloss: String = gm.get_word_translation(word)
		fails += _check(gloss != "", "'%s' has a translation ('%s')" % [word, gloss])
	return fails

func _check_short_translations(gm: Node) -> int:
	var fails: int = 0
	for word: String in ["a", "an", "and", "the", "cat", "dog", "ox", "zoo", "hi"]:
		var gloss: String = gm.get_word_translation(word)
		fails += _check(gloss != "", "short word '%s' is translated ('%s')" % [word, gloss])

	# The first-2000 batch is translated in full, so translations are no longer
	# limited to <=3 letters; what still has to hold is that the set is exactly
	# the three documented sources (samples + head2000 + short words).
	var head_2000: Dictionary = _load_head_2000_file()
	fails += _check(head_2000.size() == 2000,
		"the head-2000 batch holds 2000 entries (%d)" % head_2000.size())
	for key: String in gm.word_translations:
		if not SAMPLE_WORDS.has(key) and not head_2000.has(key) and key.length() > 3:
			fails += _check(false, "'%s' has no documented source" % key)
			break
	fails += _check(true, "every translation traces back to a documented source")
	return fails


## Reads the head-2000 source table straight from disk.
func _load_head_2000_file() -> Dictionary:
	var file := FileAccess.open("res://_head2000.json", FileAccess.READ)
	if file == null:
		return {}
	var parsed: Variant = JSON.parse_string(file.get_as_text())
	file.close()
	if typeof(parsed) != TYPE_DICTIONARY:
		return {}
	return parsed

func _check_case_insensitive(gm: Node) -> int:
	var fails: int = 0
	var lower: String = gm.get_word_translation("cat")
	for variant: String in ["CAT", "Cat", "cAt"]:
		fails += _check(gm.get_word_translation(variant) == lower,
			"'%s' resolves to the same gloss" % variant)
	fails += _check(gm.has_word_translation("  CAT  "), "surrounding whitespace is ignored")
	return fails

## A gloss must never exist for a word the game would reject.
func _check_no_phantom_words(gm: Node) -> int:
	var fails: int = 0
	for key: String in gm.word_translations:
		if not gm.dictionary.has(key):
			fails += _check(false, "'%s' is translated but not a valid word" % key)
			break
	fails += _check(true, "every translated word is a real dictionary word")
	fails += _check(gm.get_word_translation("zzzznotaword") == "",
		"an unknown word has no gloss")
	return fails

## The UI must show the bundled gloss without touching the network.
func _check_ui_shows_gloss(gm: Node) -> int:
	var fails: int = 0
	var main = (load("res://Main.tscn") as PackedScene).instantiate()
	add_child(main)
	await get_tree().process_frame
	await get_tree().process_frame

	main._refresh_word_meaning("CAT")
	fails += _check(str(main.meaning_label.text) == gm.get_word_translation("cat"),
		"the UI shows the bundled gloss ('%s')" % str(main.meaning_label.text))
	fails += _check(str(main.meaning_label.text) != "", "the meaning label is not empty")

	main._refresh_word_meaning("")
	fails += _check(str(main.meaning_label.text) == "", "an empty word clears the label")
	return fails


## The real player flow: put a translated word on the Workbench and confirm the
## gloss reaches the on-screen label. Uses a genuine 3-letter word so the whole
## path (add card -> preview -> meaning) runs exactly as in a real game.
func _check_ui_real_word_flow(gm: Node) -> int:
	var fails: int = 0
	var main = (load("res://Main.tscn") as PackedScene).instantiate()
	add_child(main)
	await get_tree().process_frame
	await get_tree().process_frame

	# Build "CAT" out of three hand cards so the Workbench holds a real word.
	var letters := ["C", "A", "T"]
	for i in range(3):
		GameManager.hand[i] = {"letter": letters[i], "damage": 1, "color": "red"}
	main._refresh_ui()
	await get_tree().process_frame

	for i in range(3):
		main.add_card_to_workbench({
			"type": "hand", "hand_index": i, "char": letters[i],
			"card_letter": letters[i], "damage": 1, "color": "red", "is_wildcard": false
		})
		await get_tree().process_frame

	fails += _check(main.workbench_cards.size() == 3,
		"three cards are on the Workbench (%d)" % main.workbench_cards.size())

	var text: String = str(main.meaning_label.text)
	print("  word 'CAT' -> meaning label: \"%s\"" % text)
	fails += _check(text == gm.get_word_translation("cat"),
		"the on-screen label shows the Japanese gloss ('%s')" % text)
	fails += _check(main.meaning_label.is_visible_in_tree(),
		"the meaning label is actually visible in the tree")
	fails += _check(main.meaning_label.size.y > 0.0,
		"the meaning label has a real height (%.1f)" % main.meaning_label.size.y)
	# The gloss must be Japanese text, not an English definition or an error.
	fails += _check(text.find("Jisho") == -1 and text.find("unavailable") == -1
			and text.find("Looking up") == -1,
		"the label shows a translation, not a status/error message")
	return fails


## A word with no bundled gloss must NOT claim to have one: it falls through to
## Jisho, and when that is unavailable the line must not invent a translation.
func _check_untranslated_shows_nothing(gm: Node) -> int:
	var fails: int = 0
	var main = (load("res://Main.tscn") as PackedScene).instantiate()
	add_child(main)
	await get_tree().process_frame
	await get_tree().process_frame

	# A valid but untranslated word (longer than 3 letters, not a sample word).
	var probe := "abandon" if not gm.has_word_translation("abandon") else "zebra"
	fails += _check(not gm.has_word_translation(probe),
		"the probe word '%s' genuinely has no bundled gloss" % probe)

	main._refresh_word_meaning(probe)
	var text: String = str(main.meaning_label.text)
	fails += _check(text.find("ツチブタ") == -1 and text.find("捨てる") == -1,
		"an untranslated word shows no bogus Japanese gloss ('%s')" % text)
	return fails

func _check(ok: bool, label: String) -> int:
	if ok:
		print("  ok   - ", label)
		return 0
	printerr("  FAIL - ", label)
	return 1
